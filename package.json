{
  "name": "shopledger",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLedger — Multi-Tenant Shop Credit & Debt Management SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:admin": "npm --workspace=apps/admin run dev",
    "build:admin": "npm --workspace=apps/admin run build",
    "start:admin": "npm --workspace=apps/admin run start",
    "dev:mobile": "npm --workspace=apps/mobile run start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "lint": "npm --workspaces --if-present run lint"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

