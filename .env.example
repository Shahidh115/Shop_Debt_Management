# ============================================================================
# ShopLedger — Environment Configuration (.env.example)
# NEVER commit real secrets or SUPABASE_SERVICE_ROLE_KEY to client bundles.
# ============================================================================

# --- Shared Supabase Project ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-Only Secrets (Admin Server Actions & Supabase Edge Functions ONLY) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only
INITIAL_ADMIN_EMAIL=dilani@shopledger.lk

# --- Application URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_SCHEME=shopledger

# --- Email / Notification Provider (Edge Functions) ---
RESEND_API_KEY=re_your_api_key
SMTP_FROM_EMAIL=noreply@shopledger.lk

